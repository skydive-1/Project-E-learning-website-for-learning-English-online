# ==========================================
# E-Learning Platform - Backend Environment Variables (.env.example)
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Lưu ý: Khi chạy qua Docker Compose, các thông số dưới sẽ được ghi đè tự động
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elearning_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRE=7d

# Pinecone Vector Database (RAG Search)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX=elearning-rag

# Google Gemini (Google AI Studio - MIỄN PHÍ 100% không cần thẻ/billing)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_SPEAKING_MODEL=gemini-3.7-flash

# Supabase Storage & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Video Security & Streaming Settings
# ENABLE_DRM_PACKAGING: Mặc định là false (MP4 Storage & Protected Streaming). Chỉ bật true khi Shaka Packager và pipeline E2E sẵn sàng.
ENABLE_DRM_PACKAGING=false

# Email SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="E-Learning AI <your_email@gmail.com>"

