# ==========================================
# E-Learning Platform - Backend Environment Variables (.env.example)
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Lưu ý: Khi chạy qua Docker Compose, các thông số dưới sẽ được ghi đè tự động
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elearning_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRE=7d

# Pinecone Vector Database (RAG Search)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX=elearning-rag

# Google Cloud Vertex AI (Gemini 2.5 + ADC Authentication)
# Không cần API Key. Hệ thống sử dụng Application Default Credentials (ADC)
# hoặc Service Account Key được nạp an toàn.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json  # (Tùy chọn: chỉ cần nếu dùng Service Account JSON key)

# Email SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="E-Learning AI <your_email@gmail.com>"
