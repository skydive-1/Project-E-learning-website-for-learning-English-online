# ==========================================
# E-Learning Platform - Backend Environment Variables (.env.example)
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Lưu ý: Khi chạy qua Docker Compose, các thông số dưới sẽ được ghi đè tự động
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elearning_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRE=7d

# Pinecone Vector Database (RAG Search)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX=elearning-rag

# Google Gemini (Google AI Studio - MIỄN PHÍ 100% không cần thẻ/billing)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_SPEAKING_MODEL=gemini-3.7-flash

# Supabase Storage & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Video Security & Streaming Settings
# Bắt buộc true để video upload mới được mã hóa DASH CENC thay vì phát MP4 thường.
ENABLE_DRM_PACKAGING=true
# Vé phát được đặt trong cookie HttpOnly và tự gia hạn ở frontend.
VIDEO_TICKET_TTL_SECONDS=60
# Mỗi response MP4 chỉ trả tối đa 8 MiB; player sẽ tiếp tục bằng Range kế tiếp.
VIDEO_MAX_CHUNK_BYTES=8388608
# Giới hạn kết nối MP4 đồng thời trên cùng một vé để chặn tải chia luồng kiểu IDM.
VIDEO_MAX_PARALLEL_REQUESTS=3
# Không bật trong production: query ticket làm lộ vé trong URL/access log.
VIDEO_ALLOW_QUERY_TICKET=false
# Production mặc định yêu cầu Origin/Referer thuộc FRONTEND_URL.
VIDEO_REQUIRE_SOURCE_HEADERS=true

# Email SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="E-Learning AI <your_email@gmail.com>"

# Durable media cleanup worker (run in one backend/worker process only)
ENABLE_MEDIA_CLEANUP_WORKER=false
MEDIA_CLEANUP_INTERVAL_MS=300000

# Request Rate Limiting
# Chỉ đặt TRUST_PROXY theo số reverse proxy tin cậy phía trước backend.
# Dùng false khi chạy trực tiếp; thường dùng 1 khi có đúng một proxy/platform load balancer.
TRUST_PROXY=false
# Chỉ có hiệu lực ngoài production. Không nên bật trừ khi chạy test cục bộ.
DISABLE_RATE_LIMIT=false
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=3000
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTRATION_WINDOW_MS=3600000
RATE_LIMIT_REGISTRATION_MAX=5
RATE_LIMIT_PASSWORD_WINDOW_MS=3600000
RATE_LIMIT_PASSWORD_MAX=5
RATE_LIMIT_AI_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_QUIZ_WINDOW_MS=900000
RATE_LIMIT_QUIZ_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_CONSULTATION_WINDOW_MS=3600000
RATE_LIMIT_CONSULTATION_MAX=5
RATE_LIMIT_MEDIA_TICKET_WINDOW_MS=900000
RATE_LIMIT_MEDIA_TICKET_MAX=120
RATE_LIMIT_STREAM_WINDOW_MS=900000
RATE_LIMIT_STREAM_MAX=2000
